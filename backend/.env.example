# Copy these into your hosting dashboard (Render, Railway, ...) or export them before "npm start".
PORT=3000
# REQUIRED in production: a long private password for the owner panel
ADMIN_KEY=put-a-long-random-password-here
# The address(es) of your website, comma separated. Use * only for testing.
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
# Where posts and uploaded files are saved. Point this to a persistent disk/volume when hosting.
DATA_DIR=./data
NODE_ENV=production
